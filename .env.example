# ==============================================================================
# ChotKeo.vn — Cấu hình Adapter Providers (Phase 1 Mock / Phase 2 Real APIs)
# ==============================================================================

# Mặc định tất cả dùng "mock" cho Phase 1 (không cần API key để chạy).
# Khi tích hợp API thật ở Phase 2, đổi giá trị tương ứng và điền API Key bên dưới.

FLIGHT_PROVIDER=mock       # mock | amadeus
BUS_PROVIDER=mock          # mock | vexere
LODGING_PROVIDER=mock      # mock | affiliate
PLACES_PROVIDER=mock       # mock | google
RENTAL_PROVIDER=mock       # mock | google
RIDE_PROVIDER=mock         # mock | partner

# --- Phase 2: Supabase (Auth, Cloud Database, Realtime Collaboration & Voting) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Phase 2: Flight APIs (Amadeus / Skyscanner Partner) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
SKYSCANNER_PARTNER_KEY=

# --- Phase 2: Bus Ticket APIs (Vexere / FUTA Partner) ---
VEXERE_PARTNER_TOKEN=
VEXERE_API_BASE_URL=https://partner-api.vexere.com/v1

# --- Phase 2: Accommodation Affiliate APIs (Agoda / Booking / Trivago) ---
AGODA_AFFILIATE_CID=
AGODA_API_KEY=
BOOKING_AFFILIATE_ID=

# --- Phase 2: Google Places API (Restaurants, Ratings & Motorbike Rental Shops) ---
GOOGLE_PLACES_API_KEY=

# --- Phase 2: Ride-Hailing Partner Estimator ---
RIDE_ESTIMATE_API_KEY=
